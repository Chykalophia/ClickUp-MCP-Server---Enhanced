# Hosted (HTTP) ClickUp MCP server. See docs/HOSTED_SERVER.md.
# (Named hosted.env.example, not .env.*, because .gitignore ignores .env.*)
# Set these in your host's environment settings. Never commit real values.

# Public origin of this deployment (no path). On Vercel, when unset, it falls back
# to the production domain in production and the deployment's own URL on previews.
CLICKUP_MCP_PUBLIC_URL=https://clickup-mcp.example.com

# From your ClickUp OAuth app (ClickUp > Settings > Apps > Create new app).
# The app's redirect URL must be: <CLICKUP_MCP_PUBLIC_URL>/oauth/clickup/callback
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=

# Encrypts every token this server issues. 32+ characters.
# Generate: openssl rand -base64 48
# Changing it signs everyone out.
CLICKUP_MCP_TOKEN_SECRET=

# Who may sign in. At least one is required; anyone matching ANY list is admitted.
# The workspace rule admits guests of that workspace too.
# Comma separated. Re-checked on every request, so removing someone revokes access.
CLICKUP_ALLOWED_USER_IDS=
CLICKUP_ALLOWED_EMAILS=
CLICKUP_ALLOWED_WORKSPACE_IDS=

# Optional
# CLICKUP_MCP_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# CLICKUP_MCP_ALLOW_LOOPBACK_REDIRECTS=true   # localhost callbacks for Claude Code and other native clients
# CLICKUP_MCP_ACCESS_TOKEN_TTL=3600           # seconds (1 hour)
# CLICKUP_MCP_REFRESH_TOKEN_TTL=2592000       # seconds unused before a refresh token dies (30 days)
# CLICKUP_MCP_SESSION_MAX_AGE=7776000         # seconds from sign-in until re-sign-in is required (90 days)
# CLICKUP_MCP_TRUST_PROXY=1                   # proxy hops in front (default 0; 1 automatically on Vercel)
# CLICKUP_TOOLSETS=tasks,comments,docs         # narrow the tool surface, same as stdio
